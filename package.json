{
  "name": "code-review-action",
  "private": true,
  "bin": {
    "find-guidelines": "bin/find-guidelines.js"
  },
  "scripts": {
    "test": "nyc mocha 'tests/**/*.test.js'"
  },
  "devDependencies": {
    "dd-trace": "^6.0.0",
    "mocha": "^12.0.0",
    "nyc": "^18.0.0"
  },
  "mocha": {
    "ui": "tdd",
    "spec": "tests/**/*.test.js",
    "timeout": 10000
  },
  "nyc": {
    "include": [
      "src/**/*.js"
    ],
    "reporter": [
      "text",
      "lcov"
    ]
  },
  "overrides": {
    "mocha": {
      "glob": {
        "minimatch": {
          "brace-expansion": "^5.0.12"
        }
      },
      "minimatch": {
        "brace-expansion": "^5.0.12"
      }
    },
    "nyc": {
      "glob": {
        "minimatch": {
          "brace-expansion": "^5.0.12"
        }
      },
      "istanbul-lib-processinfo": {
        "rimraf": {
          "glob": {
            "minimatch": {
              "brace-expansion": "^5.0.12"
            }
          }
        }
      },
      "rimraf": {
        "glob": {
          "minimatch": {
            "brace-expansion": "^5.0.12"
          }
        }
      },
      "spawn-wrap": {
        "rimraf": {
          "glob": {
            "minimatch": {
              "brace-expansion": "^5.0.12"
            }
          }
        }
      },
      "test-exclude": {
        "glob": {
          "minimatch": {
            "brace-expansion": "^5.0.12"
          }
        },
        "minimatch": {
          "brace-expansion": "^5.0.12"
        }
      }
    }
  }
}
