{
  "name": "code-review-action",
  "private": true,
  "bin": {
    "find-guidelines": "bin/find-guidelines.js"
  },
  "scripts": {
    "test": "nyc mocha 'tests/**/*.test.js'"
  },
  "devDependencies": {
    "dd-trace": "^6.0.0",
    "mocha": "^11.0.0",
    "nyc": "^18.0.0"
  },
  "mocha": {
    "ui": "tdd",
    "spec": "tests/**/*.test.js",
    "timeout": 10000
  },
  "nyc": {
    "include": [
      "src/**/*.js"
    ],
    "reporter": [
      "text",
      "lcov"
    ]
  }
}
